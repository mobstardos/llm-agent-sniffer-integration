generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SnifferAlert {
  id        String   @id @default(cuid())
  rule      String
  severity  String // info | warn | crit
  message   String
  protocol  String?
  client    String?
  packetId  Int?
  createdAt DateTime @default(now())
}